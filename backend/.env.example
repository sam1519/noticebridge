# Copy this file to ".env" and edit the values.

PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/noticebridge
# Or MongoDB Atlas (free): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/noticebridge

JWT_SECRET=change_this_to_any_long_random_text

# OPTIONAL. Leave empty to use the built-in offline analyzer (basic, rule-based).
# Add a key to get full AI summaries, translations and reply drafts.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
